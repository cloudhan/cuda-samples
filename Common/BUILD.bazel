load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//:__subpackages__"])

cc_library(
    name = "helpers",
    srcs = glob(
        ["*.cpp"],
        exclude = ["rendercheck*.cpp"],
        allow_empty = True,
    ),
    hdrs = glob(
        [
            "*.h",
            "*.hxx",
        ],
        exclude = ["rendercheck*.h"],
        allow_empty = True,
    ),
    includes = ["."],
)

cc_library(
    name = "UtilNpp",
    hdrs = glob(["UtilNPP/*.h"], allow_empty = True),
    includes = ["UtilNPP"],
    deps = ["@FreeImage", "@cuda//:npp"],
)

filegroup(
    name = "data",
    data = glob(
        [
            "data/*.raw",
            "data/*.pgm",
            "data/*.ppm",
            "data/*.bmp",
        ],
        allow_empty = True,
    ),
)
