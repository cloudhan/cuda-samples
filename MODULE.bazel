module(
    name = "cuda-samples",
    version = "0.0.0",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_cuda", version = "0.4.0")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "FreeImage",
    build_file = "//third_party/FreeImage:BUILD.bazel",
    sha256 = "7dd22eeb95e967e541d864da8b3bc03e3050983f2de2cb1c09a60d28e679c6f2",
    strip_prefix = "FreeImage-3.19.10",
    urls = ["https://github.com/danoli3/FreeImage/archive/refs/tags/3.19.10.tar.gz"],
)

http_archive(
    name = "dlpack",
    build_file = "//third_party/dlpack:BUILD.bazel",
    sha256 = "f3d567f885f6c142183afc91a58873b31d0e0b36faa2e45c232b98c74596404f",
    strip_prefix = "dlpack-1.3",
    urls = ["https://github.com/dmlc/dlpack/archive/refs/tags/v1.3.tar.gz"],
)

cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
cuda.redist_json(
    name = "rules_cuda_redist_json",
    platforms = [
        "linux-x86_64",
        "linux-sbsa",
        "windows-x86_64",
    ],
    version = "13.3.1",
)
cuda.toolkit(name = "cuda")
use_repo(cuda, "cuda")
