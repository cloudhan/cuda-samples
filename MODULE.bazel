module(
    name = "cuda-samples",
    version = "0.0.0",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_cuda", version = "0.4.0")
local_path_override(
    module_name = "rules_cuda",
    path = "../rules_cuda",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "dlpack",
    build_file = "//third_party/dlpack:BUILD.bazel",
    sha256 = "f3d567f885f6c142183afc91a58873b31d0e0b36faa2e45c232b98c74596404f",
    strip_prefix = "dlpack-1.3",
    urls = ["https://github.com/dmlc/dlpack/archive/refs/tags/v1.3.tar.gz"],
)

cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
cuda.toolkit(
    name = "cuda",
    toolkit_path = "",
)
use_repo(cuda, "cuda")
